<section class="collection container">
  <header class="collection__header">
    <h1 class="collection__title">{{ 'general.search.title' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" style="max-width:480px;margin:24px auto 0;">
      <div style="display:flex;align-items:center;gap:8px;border-bottom:1px solid var(--color-ink);padding-bottom:6px;">
        <input type="search" name="q" value="{{ search.terms | escape }}"
               placeholder="{{ 'general.search.placeholder' | t }}"
               aria-label="{{ 'general.search.title' | t }}"
               style="flex:1;border:0;background:transparent;outline:0;padding:8px 0;">
        <button type="submit" aria-label="{{ 'general.search.submit' | t }}">{% render 'icon', name: 'search' %}</button>
      </div>
    </form>
  </header>

  {%- if search.performed -%}
    {%- if search.results_count > 0 -%}
      <p class="t-muted" style="text-align:center;margin-bottom:24px;">{{ 'general.search.results_for' | t: terms: search.terms }}</p>
      <div class="collection__grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'product-card', product: item, placeholder_index: forloop.index0 %}
          {%- else -%}
            <a href="{{ item.url }}" class="product-card">
              <div class="product-card__info">
                <h3 class="product-card__title">{{ item.title }}</h3>
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p style="text-align:center;">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
    {%- endif -%}
  {%- endif -%}
</section>
