<section class="content-cards" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="content-cards__grid">
      {%- for block in section.blocks -%}
        <article class="content-card reveal-on-scroll" {{ block.shopify_attributes }}>
          <div class="content-card__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag:
                 loading: 'lazy',
                 widths: '300,500,700,800',
                 sizes: '(min-width: 750px) 20vw, 40vw',
                 alt: block.settings.heading
              }}
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="content-card__body-wrap">
            <h3 class="content-card__heading">{{ block.settings.heading }}</h3>
            {%- if block.settings.body != blank -%}
              <p class="content-card__body">{{ block.settings.body }}</p>
            {%- endif -%}
            {%- if block.settings.cta_label != blank -%}
              {% render 'underlined-link',
                 label: block.settings.cta_label,
                 url: block.settings.cta_url %}
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cartes contenu",
  "tag": "section",
  "blocks": [
    {
      "type": "card",
      "name": "Carte",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Titre", "default": "The Journal" },
        { "type": "textarea", "id": "body", "label": "Texte", "default": "Stories on modest fashion, care, styling and everyday elegance." },
        { "type": "text", "id": "cta_label", "label": "Lien — texte", "default": "Read More" },
        { "type": "url", "id": "cta_url", "label": "Lien — URL" }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [
    {
      "name": "Cartes contenu",
      "category": "Text",
      "blocks": [
        { "type": "card", "settings": { "heading": "The Journal", "body": "Stories on modest fashion, care, styling and everyday elegance.", "cta_label": "Read More" } },
        { "type": "card", "settings": { "heading": "Our Promise", "body": "Soft fabrics, refined cuts and pieces designed with comfort, coverage and elegance in mind.", "cta_label": "Learn More" } }
      ]
    }
  ]
}
{% endschema %}
