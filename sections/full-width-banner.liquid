{%- liquid
  assign text_class = ''
  if section.settings.text_color == 'dark'
    assign text_class = 'banner--text-dark'
  endif
-%}
<section class="banner {{ text_class }}" data-section-id="{{ section.id }}">
  {%- if section.settings.image != blank -%}
    {{ section.settings.image | image_url: width: 2400 | image_tag:
       loading: 'lazy',
       widths: '800,1200,1600,2000,2400',
       sizes: '100vw',
       class: 'banner__image',
       alt: section.settings.heading
    }}
  {%- else -%}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'banner__image placeholder-svg' }}
  {%- endif -%}

  <div class="banner__overlay" aria-hidden="true"></div>

  <div class="banner__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="banner__heading reveal-on-scroll">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <div class="reveal-on-scroll">
        {% render 'underlined-link',
           label: section.settings.link_label,
           url: section.settings.link_url %}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Bannière pleine largeur",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image de fond" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "The Ramadan Edit" },
    { "type": "text", "id": "link_label", "label": "Lien — texte", "default": "Shop Lookbook" },
    { "type": "url", "id": "link_url", "label": "Lien — URL" },
    {
      "type": "select", "id": "text_color", "label": "Couleur du texte",
      "options": [
        { "value": "light", "label": "Clair" },
        { "value": "dark", "label": "Sombre" }
      ],
      "default": "light"
    }
  ],
  "presets": [
    { "name": "Bannière pleine largeur", "category": "Image", "settings": {} }
  ]
}
{% endschema %}
