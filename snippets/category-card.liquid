{%- comment -%}
  Renders a category card.
  Inputs: image, label, url
{%- endcomment -%}
<a href="{{ url | default: '#' }}" class="category-card reveal-on-scroll">
  <div class="category-card__media">
    {%- if image != blank -%}
      {{ image | image_url: width: 800 | image_tag:
         loading: 'lazy',
         widths: '300,500,700,900',
         sizes: '(min-width: 750px) 22vw, 45vw',
         alt: label
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
  <span class="category-card__label u-link">{{ label }}</span>
</a>
